# Server-only upstream used by the same-origin /api gateway.
API_BASE_URL=http://localhost:3001

# Optional Sentry error tracking (docs/observability.md). The NEXT_PUBLIC_*
# values are inlined into the browser bundle at build time; SENTRY_DSN is read
# by the Next server at runtime (the /api gateway and render errors).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Source-map upload for readable production stack traces; all three required.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
