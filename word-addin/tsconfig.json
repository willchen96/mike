{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "react": [
        "node_modules/@types/react/index.d.ts"
      ],
      "react/jsx-runtime": [
        "node_modules/@types/react/jsx-runtime.d.ts"
      ],
      "react-dom": [
        "node_modules/@types/react-dom/index.d.ts"
      ],
      "lucide-react": [
        "node_modules/lucide-react"
      ],
      "clsx": [
        "node_modules/clsx"
      ],
      "tailwind-merge": [
        "node_modules/tailwind-merge"
      ],
      "@radix-ui/react-dropdown-menu": [
        "node_modules/@radix-ui/react-dropdown-menu"
      ],
      "@mike/edit-card-ui": [
        "../frontend/src/shared/ui/EditCardUI.tsx"
      ],
      "@mike/edit-cards-section-ui": [
        "../frontend/src/shared/ui/EditCardsSectionUI.tsx"
      ],
      "@mike/pre-response-wrapper-ui": [
        "../frontend/src/shared/ui/PreResponseWrapperUI.tsx"
      ],
      "@mike/document-event-blocks-ui": [
        "../frontend/src/shared/ui/DocumentEventBlocksUI.tsx"
      ],
      "@mike/glass-card-ui": [
        "../frontend/src/shared/ui/GlassCardUI.tsx"
      ],
      "@mike/liquid-glass-ui": [
        "../frontend/src/shared/ui/LiquidGlassUI.ts"
      ],
      "@mike/modal-ui": [
        "../frontend/src/shared/ui/ModalUI.tsx"
      ],
      "@mike/header-buttons-ui": [
        "../frontend/src/shared/ui/HeaderButtonsUI.tsx"
      ],
      "@mike/pill-button-ui": [
        "../frontend/src/shared/ui/PillButtonUI.tsx"
      ],
      "@mike/dropdown-ui": [
        "../frontend/src/shared/ui/DropdownUI.tsx"
      ],
      "@mike/citation-pill-ui": [
        "../frontend/src/shared/ui/CitationPillUI.tsx"
      ],
      "@mike/model-toggle-ui": [
        "../frontend/src/shared/ui/ModelToggleUI.tsx"
      ],
      "@mike/mike-icon-ui": [
        "../frontend/src/shared/ui/MikeIconUI.tsx"
      ],
      "@mike/google-icon-ui": [
        "../frontend/src/shared/ui/GoogleIconUI.tsx"
      ],
      "@mike/auth-styles-ui": [
        "../frontend/src/shared/ui/AuthStylesUI.ts"
      ],
      "@mike/auth-divider-ui": [
        "../frontend/src/shared/ui/AuthDividerUI.tsx"
      ],
      "@mike/workflow-slash-command-ui": [
        "../frontend/src/shared/ui/WorkflowSlashCommandUI.tsx"
      ],
      "@mike/upload-session-client": [
        "../frontend/src/shared/api/uploadSessionClient.ts"
      ],
      "@mike/secure-uuid": [
        "../frontend/src/shared/lib/secureUuid.ts"
      ]
    },
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src"]
}
