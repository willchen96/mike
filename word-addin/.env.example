# Local Word add-in bundle values. Copy this file to `.env` when configuring
# the add-in manually; `scripts/dev.sh` can generate the same file from the
# backend configuration.
REACT_APP_API_BASE_URL=https://localhost:3200/api
REACT_APP_WEB_APP_URL=https://app.mikeoss.com

# Set to 0 to make `npm start` and scripts/dev.sh skip automatic sideloading.
# `bun dev` and `npm run dev` always run webpack directly in the foreground.
WORD_ADDIN_SIDELOAD=1

# Real upstreams reached by the webpack HTTPS proxy.
API_PROXY_TARGET=http://localhost:3001
# Runtime upstream for `npm run start:production` / the production Docker image.
# The browser still uses /api on the add-in origin; this value is server-only.
WORD_ADDIN_BACKEND_ORIGIN=http://localhost:3001
OBJECT_STORAGE_PROXY_TARGET=http://localhost:9000
OBJECT_STORAGE_BUCKET_NAME=mike

# Optional Sentry error tracking, baked into the bundle at build time
# (docs/observability.md). Leave empty to disable.
REACT_APP_SENTRY_DSN=
REACT_APP_SENTRY_ENVIRONMENT=
REACT_APP_SENTRY_RELEASE=
# Source-map upload for readable stack traces; all three required.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
